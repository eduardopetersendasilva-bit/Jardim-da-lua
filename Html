<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Jardim da Lua</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- CABEÇALHO -->
    <header class="cabecalho">

        <div>
            <h1>🌙 Jardim da Lua</h1>
            <p>Seu espaço de segurança</p>
        </div>

        <button id="temaBtn" class="icone-btn">
            🌙
        </button>

    </header>


    <!-- CONTEÚDO PRINCIPAL -->
    <main>

        <!-- CARTÃO DE BOAS-VINDAS -->
        <section class="boas-vindas">

            <p class="pequeno">COMO VOCÊ ESTÁ?</p>

            <h2>Você está em um lugar seguro?</h2>

            <p>
                Se precisar de ajuda, use uma das opções abaixo.
            </p>

        </section>


        <!-- BOTÃO DE EMERGÊNCIA -->
        <section class="emergencia">

            <div class="icone-emergencia">
                🆘
            </div>

            <div>
                <h2>Precisa de ajuda?</h2>

                <p>
                    Em uma situação de perigo imediato,
                    procure ajuda.
                </p>
            </div>

            <button id="emergenciaBtn">
                PEDIR AJUDA
            </button>

        </section>


        <!-- AÇÕES RÁPIDAS -->
        <section>

            <h2 class="titulo-secao">
                Ações rápidas
            </h2>

            <div class="grid">

                <button class="card" id="policiaBtn">
                    <span>🚓</span>
                    <strong>Polícia</strong>
                    <small>Ligar para 190</small>
                </button>

                <button class="card" id="localizacaoBtn">
                    <span>📍</span>
                    <strong>Localização</strong>
                    <small>Compartilhar localização</small>
                </button>

                <button class="card" id="orientacaoBtn">
                    <span>🛡️</span>
                    <strong>Orientações</strong>
                    <small>O que fazer?</small>
                </button>

                <button class="card" id="alertaBtn">
                    <span>🔊</span>
                    <strong>Alerta</strong>
                    <small>Ativar som</small>
                </button>

            </div>

        </section>


        <!-- ÁREA DE ORIENTAÇÃO -->
        <section class="orientacao" id="orientacao">

            <h2>🛡️ Em uma emergência</h2>

            <div class="passo">
                <span>1</span>
                <p>
                    Procure um local seguro.
                </p>
            </div>

            <div class="passo">
                <span>2</span>
                <p>
                    Procure uma pessoa adulta de confiança.
                </p>
            </div>

            <div class="passo">
                <span>3</span>
                <p>
                    Se houver perigo imediato, procure os
                    serviços de emergência.
                </p>
            </div>

            <div class="passo">
                <span>4</span>
                <p>
                    Se puder, compartilhe sua localização
                    com alguém de confiança.
                </p>
            </div>

        </section>


        <!-- CONTATO DE CONFIANÇA -->
        <section class="contato">

            <h2>👤 Pessoa de confiança</h2>

            <p>
                Tenha alguém que possa ajudar você
                quando precisar.
            </p>

            <button id="contatoBtn">
                Adicionar contato
            </button>

        </section>

    </main>


    <!-- RODAPÉ -->
    <footer>

        <p>🌙 Jardim da Lua</p>

        <small>
            Um projeto criado para facilitar o acesso à ajuda.
        </small>

    </footer>


    <!-- JAVASCRIPT -->
    <script src="script.js"></script>

</body>

</html>
